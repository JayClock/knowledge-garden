{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-opportunity.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "stage", "target", "requirements", "selected_claim_ids", "artifacts", "feedback_ids", "decisions"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["intake", "mapped", "packaged", "practicing", "submitted", "interviewed", "closed"]},
    "purpose": {"enum": ["application", "interview_practice"]},
    "application_status": {"enum": ["not_planned", "planned", "submitted", "withdrawn"]},
    "target": {
      "type": "object",
      "required": ["company", "role", "jd_source", "deadline"],
      "properties": {
        "company": {"type": "string"},
        "role": {"type": "string", "minLength": 1},
        "jd_source": {"type": "string"},
        "deadline": {"type": ["string", "null"]},
        "planned_submission_date": {"type": ["string", "null"], "format": "date"}
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "priority", "claim_ids", "gap"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "priority": {"enum": ["must", "important", "optional"]},
          "claim_ids": {"type": "array", "items": {"type": "string"}},
          "gap": {"type": "boolean"}
        }
      }
    },
    "selected_claim_ids": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "feedback_ids": {"type": "array", "items": {"type": "string"}},
    "decisions": {"type": "array", "items": {"type": "object"}}
  }
}
