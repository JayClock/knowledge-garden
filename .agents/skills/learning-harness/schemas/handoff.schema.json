{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-garden.local/learning/handoff.schema.json",
  "title": "Visual PKM Learning Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_id", "unit_id", "skill", "mode", "action", "observations", "artifact_paths", "open_questions", "workflow", "suggested_next", "needs_user_decision"],
  "properties": {
    "project_id": { "$ref": "#/$defs/id" },
    "unit_id": { "type": ["string", "null"] },
    "skill": { "const": "visual-pkm" },
    "mode": { "enum": ["deep-reading", "concept-visualization", "spatial-mapping", "idea-integration", "knowledge-exploration", "narrative-composition"] },
    "action": { "type": "string", "minLength": 1 },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "subject", "payload", "evidence_refs", "caused_by"],
        "properties": {
          "type": { "enum": ["coverage_recorded", "expression_qualified", "evidence_checked", "claim_registered", "distillation_decided", "attempt_recorded", "blocker_added", "blocker_resolved"] },
          "subject": {
            "type": "object",
            "required": ["kind", "id"],
            "properties": { "kind": { "type": "string" }, "id": { "$ref": "#/$defs/id" } }
          },
          "payload": { "type": "object" },
          "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/fileRef" } },
          "caused_by": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "artifact_paths": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "workflow": { "type": ["object", "null"] },
    "suggested_next": { "type": ["object", "null"] },
    "needs_user_decision": { "type": "boolean" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "fileRef": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": { "const": "file" },
        "path": { "type": "string", "minLength": 1 },
        "locator": { "type": ["string", "null"] }
      }
    }
  }
}
